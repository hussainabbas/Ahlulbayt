NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://ahlulbayt:ahlulbayt@localhost:5432/ahlulbayt
REDIS_URL=redis://localhost:6379
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars!!
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars!!
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=30d
GOOGLE_CLIENT_ID=595645974841-9vu5g0ideh3utlislgcs3cqshis6dts0.apps.googleusercontent.com
APPLE_CLIENT_ID=com.ahlulbayt.app
APPLE_TEAM_ID=
APPLE_KEY_ID=
OTP_EXPIRES_MINUTES=10
OTP_MAX_ATTEMPTS=5
PASSWORD_RESET_EXPIRES_MINUTES=60

# Production (Railway): set NODE_ENV=production, reference DATABASE_URL from Postgres plugin,
# generate JWT_ACCESS_SECRET, MONETIZATION_DEV_MODE=false. See api/RAILWAY.md.

# First admin account (npm run db:seed:admin). There is no built-in default password.
# ADMIN_SEED_EMAIL=you@example.com
# ADMIN_SEED_PASSWORD=<at least 12 characters>
# ADMIN_SEED_RESET_PASSWORD=true   # only to overwrite an existing admin's password

# Browser origins allowed to call the API (admin dashboard), comma separated.
# Required in production; unset in development allows any origin.
# CORS_ORIGINS=https://admin.ahlulbayt.app
# Reverse-proxy hops to trust for the client IP (defaults to 1 in production).
# TRUST_PROXY=1
# Shared secret for store webhooks: https://<api>/v1/webhooks/apple?token=<value>
# WEBHOOK_TOKEN=

# Content CDN (S3/CloudFront) — bundle URLs in manifest are prefixed with this
# Falls back to APP_PUBLIC_URL or Railway public domain when unset
CONTENT_CDN_BASE_URL=https://cdn.ahlulbayt.app
# APP_PUBLIC_URL=https://ahlulbayt-production.up.railway.app

# AI provider: local (rule engine) | openai (future)
AI_PROVIDER=local
OPENAI_API_KEY=

# Monetization — must be false in production (the API refuses to start otherwise)
MONETIZATION_DEV_MODE=true
