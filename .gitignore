# Dependencies
node_modules/

# Environment (keep example templates)
.env
.env.*
!.env.example
!.env*.example

# Log output (root only — do not use bare logs/ or api/src/admin/logs is ignored)
/logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# OS
.DS_Store
Thumbs.db
Desktop.ini

# IDE / editors
.idea/
.vscode/
*.swp
*.swo
*~

# Cursor local state
.cursor/
.claude/

# TypeScript
*.tsbuildinfo

# Test / coverage
coverage/
.nyc_output/

# Caches
.cache/
.turbo/
.eslintcache

# --- API (NestJS) ---
api/dist/
api/coverage/

# Quran corpus (Tanzil). The pinned source text, its metadata and the generated
# mobile bundles ARE committed so the verified Quran ships offline and CI can
# verify it without network access. Only derived duplicates are ignored.
api/data/quran/source/surah-*.json
api/data/quran/source/*.candidate.txt
api/data/quran/bundles/

# --- Mobile (React Native) ---
mobile/android/app/build/
mobile/android/app/release/
mobile/android/build/
mobile/android/.gradle/
mobile/android/local.properties
mobile/android/.cxx/
mobile/ios/build/
mobile/ios/Pods/
mobile/ios/DerivedData/
mobile/.metro-health-check*
mobile/.rn-scaffold/
mobile/.kotlin/
mobile/.expo/
mobile/.expo-shared/

# Mobile release binaries (never commit)
*.apk
*.aab
*.ipa
*.app
*.dSYM.zip

# Native signing & secrets (never commit)
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.pem
*.orig.*

# Docker local overrides
docker-compose.override.yml

# --- Admin (Next.js) ---
admin/.next/
